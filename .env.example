# Commerce backend: "mock" (default) or "shopify"
COMMERCE_PROVIDER=mock

# Shopify Storefront API — Shopify admin → Settings → Apps → Headless / Storefront API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10

# Public URL, used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000
